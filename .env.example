# Copy to .env and fill in — Build Order, Phase 1, Step 1.
# Get both values from your Supabase project: Settings → API.
# EXPO_PUBLIC_ vars are bundled into the client; only ever put the anon
# (publishable) key here — NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Later phases (server-side only — these do NOT get an EXPO_PUBLIC_ prefix
# and must never ship inside the app bundle):
# OPENAI_API_KEY=          # Whisper speech-to-text (Phase 2, Step 5)
# ANTHROPIC_API_KEY=       # Triangulation Matrix + Paperwork Decoder (Phase 3)
# ELEVENLABS_API_KEY=      # TTS — swappable module (Phase 3, Step 10)
